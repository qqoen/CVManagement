@model List<CVManagement.Models.CVAttribute>;

@{
    ViewData["Title"] = "Attributes";
}

<div class="d-flex gap-2 mb-3">
    <button class="btn btn-danger" id="delete-btn">Delete</button>
    <a class="btn btn-primary" asp-action="Create">Create New</a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>
                <input type="checkbox" id="select-all" />
            </th>
            <th>Name</th>
            <th>Description</th>
            <th>Category</th>
            <th>Data Type</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var position in Model)
        {
            <tr>
                <td>
                    <input type="checkbox" class="attribute-checkbox" value="@position.ID" />
                </td>
                <td><a asp-action="Edit" asp-route-id="@position.ID">@position.Name</a></td>
                <td>@position.Description</td>
                <td>@position.Category</td>
                <td>@position.DataType</td>
            </tr>
        }
    </tbody>
</table>

@if (Model.Count == 0)
{
    <p class="text-center">List is empty.</p>
}

@section scripts
{
    <script src="~/js/attribute.js" asp-append-version="true"></script>
}
