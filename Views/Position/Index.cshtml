@using CVManagement.Data
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@model List<CVManagement.Models.Position>;

@{
    ViewData["Title"] = "All Positions";
    var isSignedIn = SignInManager.IsSignedIn(User);
    var isAdmin = isSignedIn && User.IsInRole(DbSeeder.AdminRole);
    var hasRecruiterRights = isSignedIn && User.IsInRole(DbSeeder.RecruiterRole) || isAdmin;
}

<h1>@ViewData["Title"]</h1>
<hr />

@if (hasRecruiterRights)
{
    <div class="d-flex gap-2 mb-3">
        <button class="btn btn-danger" id="delete-btn">Delete</button>
        <a class="btn btn-primary" asp-action="Create">Create New</a>
    </div>
}

<table class="table table-striped" id="positions-table">
    <thead>
        <tr>
            @if (hasRecruiterRights)
            {
                <th><input type="checkbox" id="select-all" /></th>
            }
            <th>Position</th>
            <th>Description</th>
            <th>Max Projects</th>
            <th>Last Updated</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var position in Model)
        {
            <tr>
                @if (hasRecruiterRights)
                {
                    <td><input type="checkbox" class="position-checkbox" value="@position.ID" /></td>
                }
                <td>
                    <a asp-action="Details" asp-route-id="@position.ID">@position.Title</a>
                </td>
                <td>@position.Description</td>
                <td>@position.MaxProjects</td>
                <td>@Html.DisplayFor(m => position.LastUpdated)</td>
            </tr>
        }
    </tbody>
</table>

@if (Model.Count == 0)
{
    <p class="text-center">List is empty.</p>
}

@section scripts
{
    <script src="~/js/position.js" asp-append-version="true"></script>
}
