@model CVManagement.ViewModels.PositionViewModel;

@{
    ViewData["Title"] = "Create Position";
    var tags = ViewData["TagList"] as IEnumerable<SelectListItem>;
    var attributes = ViewData["AttributesList"] as IEnumerable<SelectListItem>;
}

<partial name="_HeaderPartial" />

<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Title" class="control-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Description" class="control-label"></label>
                <input asp-for="Description" class="form-control" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="MaxProjects" class="control-label"></label>
                <input asp-for="MaxProjects" class="form-control" />
                <span asp-validation-for="MaxProjects" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Attributes" class="control-label">Attributes</label>
                <select asp-for="Attributes" asp-items="attributes" class="form-control" id="attributes" multiple="multiple" data-allow-clear="true" data-allow-new="false">
                    <option disabled hidden value="">Choose attributes...</option>
                </select>
                <span asp-validation-for="Attributes" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Tags" class="control-label">Project Tags</label>
                <select asp-for="Tags" asp-items="tags" class="form-control" id="project-tags" multiple="multiple" data-allow-clear="true" data-allow-new="true">
                    <option disabled hidden value="">Choose tags...</option>
                </select>
                <span asp-validation-for="Tags" class="text-danger"></span>
            </div>

            <div class="form-group mt-2">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

@section scripts
{
    <script>
        Tags.init('#attributes');
        Tags.init('#project-tags');
    </script>
}
