@using CVManagement.Data
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager;
@model CVManagement.Controllers.CVAttributeController.CVAttributesViewModel

@{
    ViewData["Title"] = "Attributes";
    var isSignedIn = SignInManager.IsSignedIn(User);
    var isAdmin = isSignedIn && User.IsInRole(DbSeeder.AdminRole);
    var hasRecruiterRights = isSignedIn && User.IsInRole(DbSeeder.RecruiterRole) || isAdmin;
    var hasCandidateRights = isSignedIn && User.IsInRole(DbSeeder.CandidateRole) || isAdmin;
}

<h1>@ViewData["Title"]</h1>
<hr />

<div class="d-flex gap-2 mb-3">
    @if (hasRecruiterRights)
    {
        <button class="btn btn-danger" id="delete-btn">Delete</button>
        <a class="btn btn-primary" asp-action="Create">Create New</a>
    }
    @if (hasCandidateRights)
    {
        <button class="btn btn-primary" id="add-btn">Add to my library</button>
    }
    <div class="col-md-4">
        <form asp-action="Index" method="get">
            <div class="input-group">
                <input class="form-control" type="text" placeholder="Attribute Name" asp-for="SearchString" />
                <input class="btn btn-primary" type="submit" value="Search" />
            </div>
        </form>
    </div>
</div>
<hr />

<table class="table table-striped">
    <thead>
        <tr>
            <th>
                @if (isSignedIn)
                {
                    <input type="checkbox" id="select-all" />            
                }
            </th>
            <th>@Html.DisplayNameFor(model => model.CVAttributes[0].Name)</th>
            <th>@Html.DisplayNameFor(model => model.CVAttributes[0].Description)</th>
            <th>@Html.DisplayNameFor(model => model.CVAttributes[0].Category)</th>
            <th>@Html.DisplayNameFor(model => model.CVAttributes[0].DataType)</th>
            <th>@Html.DisplayNameFor(model => model.CVAttributes[0].IsMandatory)</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.CVAttributes)
        {
            <tr>
                <td>
                    @if (isSignedIn && !item.IsMandatory)
                    {
                        <input type="checkbox" class="attribute-checkbox" value="@item.ID" />
                    }
                </td>
                <td>
                    @if (hasRecruiterRights)
                    {
                        <a asp-action="Edit" asp-route-id="@item.ID">@Html.DisplayFor(_ => item.Name)</a>
                    }
                    else
                    {
                        @Html.DisplayFor(_ => item.Name)
                    }
                </td>
                <td>@Html.DisplayFor(_ => item.Description)</td>
                <td>@Html.DisplayFor(_ => item.Category!.Name)</td>
                <td>@Html.DisplayFor(_ => item.DataType)</td>
                <td>@Html.DisplayFor(_ => item.IsMandatory)</td>
            </tr>
        }
    </tbody>
</table>

@if (Model.CVAttributes.Count == 0)
{
    <p class="text-center">List is empty.</p>
}

@section scripts
{
    <script src="~/js/attribute.js" asp-append-version="true"></script>
}
