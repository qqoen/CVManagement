@model List<CVManagement.Models.CV>

@{
    ViewData["Title"] = "My CVs";
}

<h1>@ViewData["Title"]</h1>

<hr />

<div class="d-flex gap-2 mb-3">
    <button class="btn btn-danger" id="delete-btn">Delete</button>
</div>

<table class="table">
    <thead>
        <tr>
            <th><input type="checkbox" id="select-all" /></th>
            <th>ID</th>
            <th>
                Position
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td><input type="checkbox" class="cv-checkbox" value="@item.ID" /></td>
                <td>@item.ID</td>
                <td>
                    @item.Position!.Title
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.ID">Details</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (Model.Count == 0)
{
    <p class="text-center">List is empty.</p>
}

@section scripts
{
    <script>
        const tableSelector = new TableSelector('.cv-checkbox', '#select-all');

        $('#delete-btn').click(() => {
            $.post('/CV/Delete', JSON.stringify([...tableSelector.selectedIds])).then(() => {
                location.reload();
            });
        });
    </script>
}
