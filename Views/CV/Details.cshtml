@model CVManagement.Models.CV

@{
    ViewData["Title"] = "CV Details";
}

<partial name="_HeaderPartial" />

<dl>
    <dt>
        Position
    </dt>
    <dd>
        @Html.DisplayFor(model => model.Position!.Title)
    </dd>
</dl>

<dl>
    <dt>
        Candidate
    </dt>
    <dd>
        @Html.DisplayFor(model => model.User!.UserName)
    </dd>
</dl>

<h3>Info</h3>

@foreach (var value in Model.CVAttributeValues)
{
    <dl>
        <dt>
            @* @value.CVAttribute!.Name *@
        </dt>
        <dd>
            @value.Value
        </dd>
    </dl>
}

<hr />
<div>
    <a asp-action="Edit" asp-route-id="@Model?.ID" class="btn btn-primary">Edit</a>
</div>
