@model CVManagement.Models.Project

@{
    ViewData["Title"] = "Project Details";
}

<div>
    <h1>@Html.DisplayFor(model => model.Name)</h1>
    <a asp-area="Identity" asp-page="/Account/Manage/Projects">Back to List</a>
</div>
<hr />

<dl class="row">
    <dt>
        @Html.DisplayNameFor(model => model.Description)
    </dt>
    <dd>
        <textarea asp-for="Description" id="editor" disabled></textarea>
    </dd>
</dl>

<dl class="row">
    <dt>
        Period
    </dt>
    <dd>
        @Html.DisplayFor(model => model.StartDate) - @Html.DisplayFor(model => model.EndDate)
    </dd>
</dl>

<dl class="row">
    <dt>
        @Html.DisplayNameFor(model => model.Tags)
    </dt>
    <dd>
        @ViewData["TagList"]
    </dd>
</dl>

<hr />
<div>
    <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model?.ID">Edit</a>
</div>

@section scripts
{
    <script>
        initMarkdown('#editor', false);
    </script>
}
