@using CVManagement.Data
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@model CVManagement.ViewModels.PositionViewModel;

@{
    ViewData["Title"] = "Position Details";
    var isSignedIn = SignInManager.IsSignedIn(User);
    var isAdmin = isSignedIn && User.IsInRole(DbSeeder.AdminRole);
    var hasRecruiterRights = isSignedIn && User.IsInRole(DbSeeder.RecruiterRole) || isAdmin;
    var hasCandidateRights = isSignedIn && User.IsInRole(DbSeeder.CandidateRole) || isAdmin;
}

<partial name="_HeaderPartial" />

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<dl class="row">
    <dt class = "col-sm-2">
        @Html.DisplayNameFor(model => model.Title)
    </dt>
    <dd class = "col-sm-10">
        @Html.DisplayFor(model => model.Title)
    </dd>
</dl>

<dl class="row">
    <dt class = "col-sm-2">
        @Html.DisplayNameFor(model => model.Description)
    </dt>
    <dd class = "col-sm-10">
        @Html.DisplayFor(model => model.Description)
    </dd>
</dl>

<dl class="row">
    <dt class = "col-sm-2">
        @Html.DisplayNameFor(model => model.MaxProjects)
    </dt>
    <dd class = "col-sm-10">
        @Html.DisplayFor(model => model.MaxProjects)
    </dd>
</dl>

<dl class="row">
    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.Attributes)
    </dt>
    <dd class="col-sm-10">
        @Model.AttributeNames
    </dd>
</dl>

<dl class="row">
    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.Tags)
    </dt>
    <dd class="col-sm-10">
        @Model.TagNames
    </dd>
</dl>

<div>
    @if (hasRecruiterRights)
    {
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model?.ID">Edit</a>
        <form asp-action="Duplicate" asp-route-id="@Model?.ID">
            <input type="submit" value="Duplicate" class="btn btn-primary mt-2" />
        </form>
    }
    @if (hasCandidateRights)
    {
        <form asp-action="SubmitCV" asp-route-id="@Model?.ID" method="post">
            <input type="submit" value="Submit CV" class="btn btn-primary" />
        </form>
    }
    <br />
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
