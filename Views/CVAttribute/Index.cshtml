@using CVManagement.Data
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@model List<CVManagement.Models.CVAttribute>;

@{
    ViewData["Title"] = "Attributes";
    var isSignedIn = SignInManager.IsSignedIn(User);
    var isRecruiter = User.IsInRole(IdentitySeeder.RecruiterRole);
    var isCandidate = User.IsInRole(IdentitySeeder.CandidateRole);
}

<h1>@ViewData["Title"]</h1>
<hr />

@if (isSignedIn && isRecruiter)
{
    <div class="d-flex gap-2 mb-3">
        <button class="btn btn-danger" id="delete-btn">Delete</button>
        <a class="btn btn-primary" asp-action="Create">Create New</a>
    </div>
    <hr />
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>
                @if (isSignedIn && isRecruiter)
                {
                    <input type="checkbox" id="select-all" />            
                }
            </th>
            <th>Name</th>
            <th>Description</th>
            <th>Category</th>
            <th>Data Type</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var cvattribute in Model)
        {
            <tr>
                <td>
                    @if (isSignedIn && isRecruiter)
                    {
                        <input type="checkbox" class="attribute-checkbox" value="@cvattribute.ID" />                
                    }
                </td>
                <td>
                    @if (isSignedIn && isRecruiter)
                    {
                        <a asp-action="Edit" asp-route-id="@cvattribute.ID">@cvattribute.Name</a>
                    }
                    else if (isSignedIn && isCandidate)
                    {
                        <a asp-action="FillValue" asp-route-id="@cvattribute.ID">@cvattribute.Name</a>
                    }
                    else
                    {
                        @cvattribute.Name
                    }
                </td>
                <td>@cvattribute.Description</td>
                <td>@cvattribute.Category</td>
                <td>@cvattribute.DataType</td>
            </tr>
        }
    </tbody>
</table>

@if (Model.Count == 0)
{
    <p class="text-center">List is empty.</p>
}

@section scripts
{
    <script src="~/js/attribute.js" asp-append-version="true"></script>
}
