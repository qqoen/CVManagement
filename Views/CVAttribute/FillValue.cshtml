@model CVManagement.ViewModels.FillValueViewModel;

@{
    ViewData["Title"] = "Fill Attribute";
}

<h1>@ViewData["Title"]</h1>
<a asp-action="Index">Back to List</a>

<hr />

<div class="row">
    <div class="col-md-4"></div>
    <div class="col-md-4">
        <form asp-action="FillValue">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="ValueID" />
            <input type="hidden" asp-for="DataType" />

            <div class="form-group">
                <label class="control-label">Attribute Name</label>
                <input asp-for="Name" class="form-control" disabled />
            </div>

            <div class="form-group">
                <label class="control-label">Attribute Description</label>
                <textarea asp-for="Description" class="form-control" rows="5" disabled></textarea>
            </div>

            <div class="form-group">
                <label class="control-label">Attribute Category</label>
                <input asp-for="CategoryName" class="form-control" disabled />
            </div>

            <div class="form-group">
                @if (Model.DataType == CVAttributeDataType.Text)
                {
                    <label class="control-label">Text</label>
                    <textarea asp-for="Value1" class="form-control"></textarea>
                }
                else if (Model.DataType == CVAttributeDataType.Numeric)
                {
                    <label class="control-label">Number</label>
                    <input type="number" asp-for="Value1" class="form-control" />
                }
                else if (Model.DataType == CVAttributeDataType.Date)
                {
                    <label class="control-label">Date</label>
                    <input type="date" asp-for="Value1" class="form-control" />
                }
                else if (Model.DataType == CVAttributeDataType.Period)
                {
                    <label class="control-label">Start Date</label>
                    <input type="date" asp-for="Value1" class="form-control" />

                    <label class="control-label">End Date</label>
                    <input type="date" asp-for="Value2" class="form-control" />
                }
                else if (Model.DataType == CVAttributeDataType.Boolean)
                {
                    <div class="form-check">
                        <input asp-for="BoolValue" class="form-check-input" type="checkbox" id="checkDefault">
                        <label class="form-check-label" for="checkDefault">
                            Value
                        </label>
                    </div>
                }
                else
                {
                    <label class="control-label">Value</label>
                    <input asp-for="Value1" class="form-control" />
                }
            </div>

            <div class="form-group mt-2">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>
