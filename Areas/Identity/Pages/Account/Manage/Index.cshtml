<h3>Me</h3>
<hr />

@foreach (var attr in Model.MandatoryAttributes)
{
    <dl class="row">
        <dt>
            @attr.Name (<a asp-controller="CVAttribute" asp-action="FillValue" asp-route-id="@attr.ID">Edit</a>)
        </dt>
        <dd>
            @attr.Value
        </dd>
    </dl>
}

<h3>Info</h3>
<hr />

@foreach (var attr in Model.OtherAttributes)
{
    <dl class="row">
        <dt>
            @attr.Name (<a asp-controller="CVAttribute" asp-action="FillValue" asp-route-id="@attr.ID">Edit</a>)
        </dt>
        <dd>
            @attr.Value
        </dd>
    </dl>
}
@if (Model.OtherAttributes.Count == 0)
{
    <p>Add more <a asp-controller="CVAttribute" asp-action="Index">attributes</a> to be displayed here.</p>
}

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
