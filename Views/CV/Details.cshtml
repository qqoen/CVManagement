@model CVManagement.Models.CV

@{
    ViewData["Title"] = "CV Details";
}

<h1>CV Details</h1>

<div>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.ID)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.ID)
        </dd>
    </dl>
    <dl>
        <dt class = "col-sm-2">
            Position
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Position!.Title)
        </dd>
    </dl>
    <dl>
        <dt class = "col-sm-2">
            Candidate
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.User!.UserName)
        </dd>
    </dl>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model?.ID">Edit</a>
    <a asp-action="Index">Back to List</a>
</div>
